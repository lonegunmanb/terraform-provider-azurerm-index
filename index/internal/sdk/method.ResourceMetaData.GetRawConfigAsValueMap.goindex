package github.com/hashicorp/terraform-provider-azurerm/internal/sdk
import (
	"errors"
	"fmt"

	"github.com/hashicorp/go-cty/cty"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/ctyhelpers"
)
func (rmd ResourceMetaData) GetRawConfigAsValueMap() (map[string]cty.Value, error) {
	rawConfig, err := rmd.GetRawConfig()
	if err != nil {
		return nil, err
	}

	return asValueMap(rawConfig)
}
