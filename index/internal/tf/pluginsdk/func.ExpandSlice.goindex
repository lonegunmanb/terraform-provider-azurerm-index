package github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk
import (
	"strconv"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
)
func ExpandSlice[I, O any](input []interface{}, convert func(I) O, appendOnNil bool) *[]O {
	result := make([]O, 0, len(input))
	for _, item := range input {
		if item != nil {
			result = append(result, convert(item.(I)))
		} else if appendOnNil {
			var zero O
			result = append(result, zero)
		}
	}
	return &result
}
