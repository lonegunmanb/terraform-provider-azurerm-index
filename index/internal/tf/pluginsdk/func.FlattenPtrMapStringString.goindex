package github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk
import (
	"strconv"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
)
func FlattenPtrMapStringString(input *map[string]string) map[string]interface{} {
	result := make(map[string]interface{})
	if input == nil {
		return result
	}
	for k, v := range *input {
		result[k] = v
	}
	return result
}
