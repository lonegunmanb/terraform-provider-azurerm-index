package github.com/hashicorp/terraform-provider-azurerm/internal/tf/base64
import stdbase64 "encoding/base64"
func EncodeIfNot(data string) string {
	// Check whether the data is already Base64 encoded; don't double-encode
	if base64IsEncoded(data) {
		return data
	}
	// data has not been encoded encode and return
	return stdbase64.StdEncoding.EncodeToString([]byte(data))
}
