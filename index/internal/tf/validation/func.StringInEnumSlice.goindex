package github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation
import (
	"fmt"
	"net/mail"
	"net/url"
	"regexp"
	"slices"
	"strings"

	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/validation"
)
func StringInEnumSlice[T ~string](valid []T, ignoreCase bool) func(interface{}, string) ([]string, []error) {
	values := make([]string, len(valid))
	for i, v := range valid {
		values[i] = string(v)
	}
	return StringInSlice(values, ignoreCase)
}
