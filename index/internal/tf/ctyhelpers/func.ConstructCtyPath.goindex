package github.com/hashicorp/terraform-provider-azurerm/internal/tf/ctyhelpers
import (
	"strconv"
	"strings"

	"github.com/hashicorp/go-cty/cty"
)
func ConstructCtyPath(key string) cty.Path {
	p := cty.Path{}

	for segment := range strings.SplitSeq(key, ".") {
		if n, err := strconv.Atoi(segment); err == nil {
			p = p.IndexInt(n)
			continue
		}
		p = p.GetAttr(segment)
	}

	return p
}
