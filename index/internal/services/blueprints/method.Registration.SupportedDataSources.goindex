package github.com/hashicorp/terraform-provider-azurerm/internal/services/blueprints
import (
	"github.com/hashicorp/terraform-plugin-framework/action"
	"github.com/hashicorp/terraform-plugin-framework/ephemeral"
	"github.com/hashicorp/terraform-provider-azurerm/internal/sdk"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/blueprints/resources/blueprint_assignment"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/blueprints/resources/blueprint_definition"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/blueprints/resources/blueprint_published_version"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func (r Registration) SupportedDataSources() map[string]*pluginsdk.Resource {
	return map[string]*pluginsdk.Resource{
		"azurerm_blueprint_definition":        blueprint_definition.RegisterDataSource(),
		"azurerm_blueprint_published_version": blueprint_published_version.RegisterDataSource(),
	}
}
