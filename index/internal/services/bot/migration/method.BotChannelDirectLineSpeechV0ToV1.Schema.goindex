package github.com/hashicorp/terraform-provider-azurerm/internal/services/bot/migration
import (
	"context"
	"log"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func (BotChannelDirectLineSpeechV0ToV1) Schema() map[string]*pluginsdk.Schema {
	return map[string]*pluginsdk.Schema{
		"resource_group_name": {
			Type:     pluginsdk.TypeString,
			Required: true,
		},

		"location": {
			Type:     pluginsdk.TypeString,
			Required: true,
		},

		"bot_name": {
			Type:     pluginsdk.TypeString,
			Required: true,
		},

		"cognitive_service_access_key": {
			Type:     pluginsdk.TypeString,
			Optional: true,
		},

		"cognitive_service_location": {
			Type:     pluginsdk.TypeString,
			Optional: true,
		},

		"cognitive_account_id": {
			Type:     pluginsdk.TypeString,
			Optional: true,
		},

		"custom_speech_model_id": {
			Type:     pluginsdk.TypeString,
			Optional: true,
		},

		"custom_voice_deployment_id": {
			Type:     pluginsdk.TypeString,
			Optional: true,
		},
	}
}
