package github.com/hashicorp/terraform-provider-azurerm/internal/services/postgres/resources/postgresql_flexible_server
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/resource-manager/postgresql/2025-08-01/servers"
)
func flattenFlexibleServerCluster(cluster *servers.Cluster) []any {
	if cluster == nil {
		return []any{}
	}

	item := map[string]any{
		"size":                  pointer.From(cluster.ClusterSize),
		"default_database_name": pointer.From(cluster.DefaultDatabaseName),
	}

	return []any{item}
}
