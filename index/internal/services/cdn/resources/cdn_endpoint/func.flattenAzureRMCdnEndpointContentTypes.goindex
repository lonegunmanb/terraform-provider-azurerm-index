package github.com/hashicorp/terraform-provider-azurerm/internal/services/cdn/resources/cdn_endpoint
import (
	"github.com/Azure/azure-sdk-for-go/services/cdn/mgmt/2020-09-01/cdn" //nolint:staticcheck
	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/cdn/helpers"
)
func flattenAzureRMCdnEndpointContentTypes(input *[]string) []any {
	output := make([]any, 0)

	if input != nil {
		for _, v := range *input {
			output = append(output, v)
		}
	}

	return output
}
