package github.com/hashicorp/terraform-provider-azurerm/internal/services/cdn/resources/cdn_frontdoor_batch_rule_set
import (
	"fmt"
	"math"
	"sort"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/cdn/2026-10-01/afdorigins"
	"github.com/hashicorp/go-azure-sdk/resource-manager/cdn/2026-10-01/rulesets"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/cdn/helpers"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/cdn/validate"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func expandCdnFrontDoorBatchRuleSetConditionBaseModel(input []helpers.CdnFrontDoorRuleConditionBaseModel, key string, expand func(helpers.CdnFrontDoorRuleConditionBaseModel) (rulesets.DeliveryRuleCondition, error)) ([]rulesets.DeliveryRuleCondition, error) {
	result := make([]rulesets.DeliveryRuleCondition, 0, len(input))
	for _, c := range input {
		expandedCondition, err := expand(c)
		if err != nil {
			return nil, fmt.Errorf("expanding `%s`: %+v", key, err)
		}
		result = append(result, expandedCondition)
	}
	return result, nil
}
