package github.com/hashicorp/terraform-provider-azurerm/internal/services/oracle/validate
import (
	"regexp"

	"github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-09-01/cloudvmclusters"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func DataStorageSizeInTbs(i any, k string) ([]string, []error) {
	return validation.FloatBetween(2, 192)(i, k)
}
