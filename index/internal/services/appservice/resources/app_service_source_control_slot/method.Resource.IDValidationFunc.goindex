package github.com/hashicorp/terraform-provider-azurerm/internal/services/appservice/resources/app_service_source_control_slot
import (
	"github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-12-01/webapps"
	"github.com/hashicorp/terraform-provider-azurerm/internal/sdk"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func (r Resource) IDValidationFunc() pluginsdk.SchemaValidateFunc {
	// This is a meta resource with a 1:1 relationship with the slot it's pointed at, so we use the same ID
	return webapps.ValidateSlotID
}
