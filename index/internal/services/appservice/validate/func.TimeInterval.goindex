package github.com/hashicorp/terraform-provider-azurerm/internal/services/appservice/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func TimeInterval(i any, k string) ([]string, []error) {
	return validation.StringMatch(regexp.MustCompile(`^([0-9][0-9]):([0-5][0-9]):([0-5][0-9])$`), "must be in the form HH:MM:SS between 00:00:00 and 99:59:59")(i, k)
}
