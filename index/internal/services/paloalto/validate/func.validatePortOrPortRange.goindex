package github.com/hashicorp/terraform-provider-azurerm/internal/services/paloalto/validate
import (
	"fmt"
	"slices"
	"strconv"
	"strings"
)
func validatePortOrPortRange(input string) error {
	bounds := strings.SplitN(input, "-", 2)

	start, err := parsePort(bounds[0])
	if err != nil {
		return err
	}

	if len(bounds) == 1 {
		return nil
	}

	end, err := parsePort(bounds[1])
	if err != nil {
		return err
	}

	if start > end {
		return fmt.Errorf("range %q must start at or before its end", input)
	}

	return nil
}
