package github.com/hashicorp/terraform-provider-azurerm/internal/services/notificationhub/resources/notification_hub
import (
	"github.com/hashicorp/go-azure-sdk/resource-manager/notificationhubs/2023-09-01/hubs"
)
func flattenNotificationHubsGCMCredentials(input *hubs.GcmCredential) []any {
	if input == nil {
		return []any{}
	}

	output := make(map[string]any)
	output["api_key"] = input.Properties.GoogleApiKey

	return []any{output}
}
