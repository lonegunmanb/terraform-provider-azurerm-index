func flattenNotificationHubsGCMCredentials(input *hubs.GcmCredential) []any {
	if input == nil {
		return []any{}
	}

	output := make(map[string]any)
	output["api_key"] = input.Properties.GoogleApiKey

	return []any{output}
}
