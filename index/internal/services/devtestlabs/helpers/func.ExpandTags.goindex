package github.com/hashicorp/terraform-provider-azurerm/internal/services/devtestlabs/helpers
import "github.com/hashicorp/go-azure-helpers/lang/pointer"
func ExpandTags(input map[string]any) *map[string]string {
	output := make(map[string]string)
	for k, v := range input {
		output[k] = v.(string)
	}
	return &output
}
