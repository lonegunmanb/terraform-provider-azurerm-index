package github.com/hashicorp/terraform-provider-azurerm/internal/services/apimanagement/resources/api_management_backend
import (
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/backend"
)
func flattenApiManagementBackendProxy(input *backend.BackendProxyContract) []any {
	results := make([]any, 0)
	if input == nil {
		return results
	}
	result := make(map[string]any)
	if password := input.Password; password != nil {
		result["password"] = *password
	}
	if url := input.Url; url != "" {
		result["url"] = url
	}
	result["username"] = pointer.From(input.Username)
	return append(results, result)
}
