package github.com/hashicorp/terraform-provider-azurerm/internal/services/resource/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func ResourceDeploymentScriptAzurePowerShellVersion(i any, k string) ([]string, []error) {
	return validation.StringMatch(regexp.MustCompile(`^\d+\.\d+$`), "should be in the format `X.Y` (e.g. `9.7`)")(i, k)
}
