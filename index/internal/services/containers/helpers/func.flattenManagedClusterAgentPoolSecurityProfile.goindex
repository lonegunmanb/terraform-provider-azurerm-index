func flattenManagedClusterAgentPoolSecurityProfile(input *managedclusters.AgentPoolSecurityProfile) []any {
	if input == nil {
		return []any{}
	}

	return []any{
		map[string]any{
			"secure_boot_enabled": pointer.From(input.EnableSecureBoot),
			"vtpm_enabled":        pointer.From(input.EnableVTPM),
		},
	}
}
