package github.com/hashicorp/terraform-provider-azurerm/internal/services/containers/resources/container_group
import (
	"fmt"
	"log"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/resource-manager/containerinstance/2025-09-01/containerinstance"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func flattenGitRepoVolume(input *containerinstance.GitRepoVolume) []any {
	if input == nil {
		return []any{}
	}
	var revision, directory, repository string
	if input.Directory != nil {
		directory = *input.Directory
	}
	if input.Revision != nil {
		revision = *input.Revision
	}
	repository = input.Repository
	return []any{
		map[string]any{
			"url":       repository,
			"directory": directory,
			"revision":  revision,
		},
	}
}
