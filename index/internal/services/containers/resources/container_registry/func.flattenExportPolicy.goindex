package github.com/hashicorp/terraform-provider-azurerm/internal/services/containers/resources/container_registry
import (
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2025-11-01/registries"
)
func flattenExportPolicy(p *registries.Policies) bool {
	if p.ExportPolicy == nil {
		return false
	}

	return *p.ExportPolicy.Status == registries.ExportPolicyStatusEnabled
}
