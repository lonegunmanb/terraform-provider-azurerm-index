package github.com/hashicorp/terraform-provider-azurerm/internal/services/containers/resources/container_registry_task
import (
	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2019-06-01-preview/tasks"
)
func flattenRegistryTaskArguments(arguments *[]tasks.Argument) map[string]string {
	if arguments == nil {
		return map[string]string{}
	}

	args := map[string]string{}

	for _, argument := range *arguments {
		var (
			k        string
			v        string
			isSecret bool
		)
		k = argument.Name
		v = argument.Value

		if argument.IsSecret != nil {
			isSecret = *argument.IsSecret
		}

		// GET response won't return the value of secret arguments
		if isSecret {
			continue
		}

		args[k] = v
	}
	return args
}
