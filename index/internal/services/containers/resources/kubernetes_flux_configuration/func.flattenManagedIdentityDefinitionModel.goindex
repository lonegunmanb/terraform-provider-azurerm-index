package github.com/hashicorp/terraform-provider-azurerm/internal/services/containers/resources/kubernetes_flux_configuration
import (
	"fmt"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/kubernetesconfiguration/2025-04-01/fluxconfiguration"
	"github.com/jackofallops/giovanni/storage/2023-11-03/blob/accounts"
	"github.com/jackofallops/giovanni/storage/2023-11-03/blob/containers"
)
func flattenManagedIdentityDefinitionModel(input *fluxconfiguration.ManagedIdentityDefinition) []ManagedIdentityDefinitionModel {
	outputList := make([]ManagedIdentityDefinitionModel, 0)
	if input == nil {
		return outputList
	}
	output := ManagedIdentityDefinitionModel{
		ClientId: pointer.From(input.ClientId),
	}

	return append(outputList, output)
}
