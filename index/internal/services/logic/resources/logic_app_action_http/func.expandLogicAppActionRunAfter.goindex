package github.com/hashicorp/terraform-provider-azurerm/internal/services/logic/resources/logic_app_action_http

func expandLogicAppActionRunAfter(input []any) map[string]any {
	if len(input) == 0 {
		return nil
	}
	output := map[string]any{}
	for _, v := range input {
		b := v.(map[string]any)
		output[b["action_name"].(string)] = []string{b["action_result"].(string)}
	}

	return output
}
