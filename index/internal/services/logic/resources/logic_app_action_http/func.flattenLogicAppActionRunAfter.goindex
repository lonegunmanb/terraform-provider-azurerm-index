package github.com/hashicorp/terraform-provider-azurerm/internal/services/logic/resources/logic_app_action_http

func flattenLogicAppActionRunAfter(input map[string]any) []any {
	if len(input) == 0 {
		return []any{}
	}
	output := []any{}
	for k, v := range input {
		output = append(output, map[string]any{
			"action_name":   k,
			"action_result": v.([]any)[0],
		})
	}

	return output
}
