package github.com/hashicorp/terraform-provider-azurerm/internal/services/logic/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func IntegrationAccountAssemblyName() pluginsdk.SchemaValidateFunc {
	return validation.All(
		validation.StringLenBetween(0, 80),
		validation.StringMatch(regexp.MustCompile(`^[A-Za-z0-9.]+$`), "contains only letters, numbers, dots"),
	)
}
