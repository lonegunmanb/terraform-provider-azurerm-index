package github.com/hashicorp/terraform-provider-azurerm/internal/services/dns/resources/dns_aaaa_record
import "net"
func NormalizeIPv6Address(ipv6 any) string {
	if ipv6 == nil || ipv6.(string) == "" {
		return ""
	}
	r := net.ParseIP(ipv6.(string))
	if r == nil {
		return ""
	}
	return r.String()
}
