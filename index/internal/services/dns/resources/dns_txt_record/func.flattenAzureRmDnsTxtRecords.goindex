package github.com/hashicorp/terraform-provider-azurerm/internal/services/dns/resources/dns_txt_record
import (
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/tags"
	"github.com/hashicorp/go-azure-sdk/resource-manager/dns/2018-05-01/recordsets"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func flattenAzureRmDnsTxtRecords(records *[]recordsets.TxtRecord) []map[string]any {
	results := make([]map[string]any, 0)

	if records != nil {
		for _, record := range *records {
			value := ""
			if v := record.Value; v != nil {
				value = strings.Join(*v, "")
			}

			results = append(results, map[string]any{
				"value": value,
			})
		}
	}

	return results
}
