package github.com/hashicorp/terraform-provider-azurerm/internal/services/loadbalancer/resources/lb_backend_address_pool
import (
	"fmt"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/network/2025-07-01/loadbalancers"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func flattenGatewayLoadBalancerTunnelInterfaces(input *[]loadbalancers.GatewayLoadBalancerTunnelInterface) []any {
	if input == nil {
		return []any{}
	}

	output := make([]any, 0)

	for _, e := range *input {
		var identifier int
		if e.Identifier != nil {
			identifier = int(*e.Identifier)
		}

		t := pointer.FromEnum(e.Type)

		protocol := pointer.FromEnum(e.Protocol)

		var port int
		if e.Port != nil {
			port = int(*e.Port)
		}

		output = append(output, map[string]any{
			"identifier": identifier,
			"type":       t,
			"protocol":   protocol,
			"port":       port,
		})
	}

	return output
}
