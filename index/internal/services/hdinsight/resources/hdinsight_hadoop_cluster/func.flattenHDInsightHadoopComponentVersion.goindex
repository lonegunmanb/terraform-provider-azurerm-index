func flattenHDInsightHadoopComponentVersion(input *map[string]string) []any {
	output := make([]any, 0)

	if input != nil {
		hadoopVersion := ""
		if v, ok := (*input)["Hadoop"]; ok {
			hadoopVersion = v
		}
		output = append(output, map[string]any{
			"hadoop": hadoopVersion,
		})
	}

	return output
}
