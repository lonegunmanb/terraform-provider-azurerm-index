func flattenDevCenterProjectEnvironmentTypeUserRoleAssignmentRoles(input *map[string]environmenttypes.EnvironmentRole) []string {
	result := make([]string, 0)

	if input == nil {
		return result
	}

	for k := range *input {
		result = append(result, k)
	}

	return result
}
