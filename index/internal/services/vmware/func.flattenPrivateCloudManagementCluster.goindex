package github.com/hashicorp/terraform-provider-azurerm/internal/services/vmware
import (
	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2022-05-01/privateclouds"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func flattenPrivateCloudManagementCluster(input *privateclouds.CommonClusterProperties) []any {
	if input == nil {
		return make([]any, 0)
	}

	return []any{
		map[string]any{
			"size":  input.ClusterSize,
			"id":    input.ClusterId,
			"hosts": pluginsdk.FlattenSlice(input.Hosts),
		},
	}
}
