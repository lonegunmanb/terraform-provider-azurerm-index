package github.com/hashicorp/terraform-provider-azurerm/internal/services/redis/resources/redis_cache_access_policy
import (
	"github.com/hashicorp/go-azure-sdk/resource-manager/redis/2024-11-01/rediscacheaccesspolicies"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func (r Resource) Arguments() map[string]*pluginsdk.Schema {
	return map[string]*pluginsdk.Schema{
		"name": {
			Type:     pluginsdk.TypeString,
			Required: true,
			ForceNew: true,
		},
		"redis_cache_id": {
			Type:         pluginsdk.TypeString,
			Required:     true,
			ForceNew:     true,
			ValidateFunc: rediscacheaccesspolicies.ValidateRediID,
		},
		"permissions": {
			Type:     pluginsdk.TypeString,
			Required: true,
		},
	}
}
