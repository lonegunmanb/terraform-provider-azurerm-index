package github.com/hashicorp/terraform-provider-azurerm/internal/services/kusto/resources/kusto_cluster
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/kusto/2024-04-13/clusters"
)
func expandKustoListString(input []any) *[]string {
	result := make([]string, 0)

	for _, v := range input {
		result = append(result, v.(string))
	}

	return &result
}
