package github.com/hashicorp/terraform-provider-azurerm/internal/services/kusto/resources/kusto_cluster
import (
	"github.com/hashicorp/go-azure-sdk/resource-manager/kusto/2024-04-13/clusters"
)
func flattenKustoClusterSku(sku *clusters.AzureSku) []any {
	if sku == nil {
		return []any{}
	}

	s := map[string]any{
		"name": string(sku.Name),
	}

	if sku.Capacity != nil {
		s["capacity"] = int(*sku.Capacity)
	}

	return []any{s}
}
