package github.com/hashicorp/terraform-provider-azurerm/internal/services/recoveryservices/resources/recovery_services_vault
import (
	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservices/2025-08-01/vaults"
)
func flattenRecoveryServicesVaultPublicNetworkAccess(input *vaults.PublicNetworkAccess) bool {
	if input == nil {
		return false
	}
	return *input == vaults.PublicNetworkAccessEnabled
}
