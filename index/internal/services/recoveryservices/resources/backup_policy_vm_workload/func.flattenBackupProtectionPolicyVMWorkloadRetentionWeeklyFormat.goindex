package github.com/hashicorp/terraform-provider-azurerm/internal/services/recoveryservices/resources/backup_policy_vm_workload
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/protectionpolicies"
)
func flattenBackupProtectionPolicyVMWorkloadRetentionWeeklyFormat(input *protectionpolicies.WeeklyRetentionFormat) (weekdays, weeks []string) {
	if v := input.DaysOfTheWeek; v != nil {
		days := make([]string, 0)
		for _, d := range *v {
			days = append(days, string(d))
		}
		weekdays = days
	}

	if v := input.WeeksOfTheMonth; v != nil {
		days := make([]string, 0)
		for _, d := range *v {
			days = append(days, string(d))
		}
		weeks = days
	}

	return weekdays, weeks
}
