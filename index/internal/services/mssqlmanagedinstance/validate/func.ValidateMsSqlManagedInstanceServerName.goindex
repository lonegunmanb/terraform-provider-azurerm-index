package github.com/hashicorp/terraform-provider-azurerm/internal/services/mssqlmanagedinstance/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func ValidateMsSqlManagedInstanceServerName(i any, k string) ([]string, []error) {
	return validation.StringMatch(regexp.MustCompile(`^[0-9a-z]([-0-9a-z]{0,61}[0-9a-z])?$`), "can contain only lowercase letters, numbers, and '-', but can't start or end with '-' or have more than 63 characters")(i, k)
}
