package github.com/hashicorp/terraform-provider-azurerm/internal/services/mssqlmanagedinstance/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func ValidateMsSqlManagedInstanceDatabaseName(i any, k string) ([]string, []error) {
	return validation.StringMatch(regexp.MustCompile(`^[^<>*%&:\\\/?]{0,127}[^\s.<>*%&:\\\/?]$`), `can't end with '.' or ' ', can't contain '<,>,*,%,&,:,\,/,?' or control characters, and can't have more than 128 characters`)(i, k)
}
