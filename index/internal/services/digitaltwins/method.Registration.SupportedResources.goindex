package github.com/hashicorp/terraform-provider-azurerm/internal/services/digitaltwins
import (
	"github.com/hashicorp/terraform-plugin-framework/action"
	"github.com/hashicorp/terraform-plugin-framework/ephemeral"
	"github.com/hashicorp/terraform-provider-azurerm/internal/sdk"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/digitaltwins/resources/digital_twins_endpoint_eventgrid"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/digitaltwins/resources/digital_twins_endpoint_eventhub"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/digitaltwins/resources/digital_twins_endpoint_servicebus"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/digitaltwins/resources/digital_twins_instance"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/digitaltwins/resources/digital_twins_time_series_database_connection"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func (r Registration) SupportedResources() map[string]*pluginsdk.Resource {
	return map[string]*pluginsdk.Resource{
		"azurerm_digital_twins_endpoint_eventgrid":  digital_twins_endpoint_eventgrid.RegisterResource(),
		"azurerm_digital_twins_endpoint_eventhub":   digital_twins_endpoint_eventhub.RegisterResource(),
		"azurerm_digital_twins_endpoint_servicebus": digital_twins_endpoint_servicebus.RegisterResource(),
		"azurerm_digital_twins_instance":            digital_twins_instance.RegisterResource(),
	}
}
