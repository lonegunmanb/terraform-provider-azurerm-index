package github.com/hashicorp/terraform-provider-azurerm/internal/services/compute/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func DiskEncryptionSetName(v any, k string) ([]string, []error) {
	return validation.StringMatch(regexp.MustCompile(`^[^_\W][\w-._]{0,78}\w$`), "must be between 1 - 80 characters long, and contain only a-z, A-Z, 0-9 and _")(v, k)
}
