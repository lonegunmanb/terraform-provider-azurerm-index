package github.com/hashicorp/terraform-provider-azurerm/internal/services/compute/resources/shared_image_version
import (
	"fmt"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/compute/2023-07-03/galleryimageversions"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func expandUefiKeyList(input []any) *[]galleryimageversions.UefiKey {
	if len(input) == 0 {
		return nil
	}

	result := make([]galleryimageversions.UefiKey, 0)
	for _, v := range input {
		if item := expandUefiKey([]any{v}); item != nil {
			result = append(result, *item)
		}
	}
	return &result
}
