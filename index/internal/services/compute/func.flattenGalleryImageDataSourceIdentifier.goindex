func flattenGalleryImageDataSourceIdentifier(input *galleryimages.GalleryImageIdentifier) []any {
	if input == nil {
		return []any{}
	}

	return []any{
		map[string]any{
			"offer":     input.Offer,
			"publisher": input.Publisher,
			"sku":       input.Sku,
		},
	}
}
