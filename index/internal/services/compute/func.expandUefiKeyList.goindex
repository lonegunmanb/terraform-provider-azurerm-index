func expandUefiKeyList(input []any) *[]galleryimageversions.UefiKey {
	if len(input) == 0 {
		return nil
	}

	result := make([]galleryimageversions.UefiKey, 0)
	for _, v := range input {
		if item := expandUefiKey([]any{v}); item != nil {
			result = append(result, *item)
		}
	}
	return &result
}
