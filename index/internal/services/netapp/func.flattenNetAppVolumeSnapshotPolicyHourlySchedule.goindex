func flattenNetAppVolumeSnapshotPolicyHourlySchedule(input *snapshotpolicies.HourlySchedule) []any {
	if input == nil || (input.Minute == nil && input.SnapshotsToKeep == nil) {
		return []any{}
	}

	return []any{
		map[string]any{
			"snapshots_to_keep": input.SnapshotsToKeep,
			"minute":            input.Minute,
		},
	}
}
