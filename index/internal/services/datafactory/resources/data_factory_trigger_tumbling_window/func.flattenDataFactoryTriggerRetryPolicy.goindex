package github.com/hashicorp/terraform-provider-azurerm/internal/services/datafactory/resources/data_factory_trigger_tumbling_window
import (
	"github.com/jackofallops/kermit/sdk/datafactory/2018-06-01/datafactory"
)
func flattenDataFactoryTriggerRetryPolicy(input *datafactory.RetryPolicy) []any {
	if input == nil {
		return []any{}
	}

	count := 0
	// a little wield: after tested, it's of type float64
	if v, ok := input.Count.(float64); ok {
		count = int(v)
	}

	interval := 0
	if input.IntervalInSeconds != nil {
		interval = int(*input.IntervalInSeconds)
	}

	return []any{
		map[string]any{
			"count":    count,
			"interval": interval,
		},
	}
}
