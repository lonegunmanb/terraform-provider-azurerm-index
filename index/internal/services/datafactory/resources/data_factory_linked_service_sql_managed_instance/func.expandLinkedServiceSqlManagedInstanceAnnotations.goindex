func expandLinkedServiceSqlManagedInstanceAnnotations(input []string) *[]any {
	if len(input) == 0 {
		return nil
	}

	annotations := make([]any, len(input))
	for i, v := range input {
		annotations[i] = v
	}
	return &annotations
}
