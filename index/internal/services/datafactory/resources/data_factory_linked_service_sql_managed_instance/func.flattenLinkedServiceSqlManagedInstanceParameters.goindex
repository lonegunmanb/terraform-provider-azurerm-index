package github.com/hashicorp/terraform-provider-azurerm/internal/services/datafactory/resources/data_factory_linked_service_sql_managed_instance
import (
	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/linkedservices"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/datafactory/helpers"
)
func flattenLinkedServiceSqlManagedInstanceParameters(input *map[string]linkedservices.ParameterSpecification) map[string]any {
	output := make(map[string]any)
	if input == nil {
		return output
	}

	for key, param := range *input {
		if param.DefaultValue != nil {
			if str, ok := pointer.From(param.DefaultValue).(string); ok {
				output[key] = str
			}
		}
	}
	return output
}
