package github.com/hashicorp/terraform-provider-azurerm/internal/services/cosmos/common
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/cosmosdb/2024-08-15/cosmosdb"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func flattenCosmosDBIndexingPolicyCompositeIndex(input []cosmosdb.CompositePath) []any {
	if input == nil {
		return []any{}
	}

	indexPairs := make([]any, 0)
	for _, v := range input {
		block := make(map[string]any)
		block["path"] = pointer.From(v.Path)
		block["order"] = v.Order
		indexPairs = append(indexPairs, block)
	}

	return indexPairs
}
