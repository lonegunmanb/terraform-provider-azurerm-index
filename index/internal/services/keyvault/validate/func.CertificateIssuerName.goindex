package github.com/hashicorp/terraform-provider-azurerm/internal/services/keyvault/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func CertificateIssuerName(v any, k string) ([]string, []error) {
	return validation.StringMatch(regexp.MustCompile(`^[0-9a-zA-Z-]+$`), "may only contain alphanumeric characters and dashes")(v, k)
}
