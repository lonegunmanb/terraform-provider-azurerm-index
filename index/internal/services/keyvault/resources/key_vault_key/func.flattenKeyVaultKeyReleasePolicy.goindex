package github.com/hashicorp/terraform-provider-azurerm/internal/services/keyvault/resources/key_vault_key
import (
	"encoding/base64"
	"strings"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/data-plane/keyvault/7-4/keys"
)
func flattenKeyVaultKeyReleasePolicy(input *keys.KeyReleasePolicy) ([]any, error) {
	if input == nil {
		return []any{}, nil
	}

	data := ""
	if input.Data != nil {
		decoded, err := base64.RawURLEncoding.DecodeString(*input.Data)
		if err != nil {
			return nil, err
		}
		data = string(decoded)
	}

	return []any{
		map[string]any{
			"json":      data,
			"immutable": pointer.From(input.Immutable),
		},
	}, nil
}
