package github.com/hashicorp/terraform-provider-azurerm/internal/services/managementgroup/validate
import (
	"regexp"

	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/validation"
)
func ManagementGroupName(i any, k string) ([]string, []error) {
	return validation.StringMatch(regexp.MustCompile(`^[a-zA-Z0-9_().-]{1,90}$`), "can only consist of ASCII letters, digits, -, _, (, ), . , and cannot exceed the maximum length of 90")(i, k)
}
