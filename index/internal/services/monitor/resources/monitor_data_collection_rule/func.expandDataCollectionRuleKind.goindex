func expandDataCollectionRuleKind(input string) *datacollectionrules.KnownDataCollectionRuleResourceKind {
	if input == "" {
		return nil
	}

	return pointer.ToEnum[datacollectionrules.KnownDataCollectionRuleResourceKind](input)
}
