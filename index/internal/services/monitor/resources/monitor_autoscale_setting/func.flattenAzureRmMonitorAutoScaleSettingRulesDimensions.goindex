package github.com/hashicorp/terraform-provider-azurerm/internal/services/monitor/resources/monitor_autoscale_setting
import (
	"fmt"
	"maps"
	"strconv"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/insights/2022-10-01/autoscalesettings"
)
func flattenAzureRmMonitorAutoScaleSettingRulesDimensions(dimensions *[]autoscalesettings.ScaleRuleMetricDimension) []any {
	results := make([]any, 0)

	if dimensions == nil {
		return results
	}

	for _, dimension := range *dimensions {
		results = append(results, map[string]any{
			"name":     dimension.DimensionName,
			"operator": string(dimension.Operator),
			"values":   dimension.Values,
		})
	}
	return results
}
