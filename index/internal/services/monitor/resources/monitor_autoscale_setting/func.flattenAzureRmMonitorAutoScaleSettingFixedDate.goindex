package github.com/hashicorp/terraform-provider-azurerm/internal/services/monitor/resources/monitor_autoscale_setting
import (
	"fmt"
	"maps"
	"strconv"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/insights/2022-10-01/autoscalesettings"
)
func flattenAzureRmMonitorAutoScaleSettingFixedDate(input *autoscalesettings.TimeWindow) []any {
	if input == nil {
		return []any{}
	}

	result := make(map[string]any)

	if timezone := input.TimeZone; timezone != nil {
		result["timezone"] = *timezone
	}
	result["start"] = input.Start
	result["end"] = input.End

	return []any{result}
}
