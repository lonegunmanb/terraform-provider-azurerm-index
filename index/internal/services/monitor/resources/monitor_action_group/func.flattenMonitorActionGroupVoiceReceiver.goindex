package github.com/hashicorp/terraform-provider-azurerm/internal/services/monitor/resources/monitor_action_group
import (
	"fmt"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/location"
	"github.com/hashicorp/go-azure-sdk/resource-manager/insights/2023-01-01/actiongroupsapis"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func flattenMonitorActionGroupVoiceReceiver(receivers *[]actiongroupsapis.VoiceReceiver) []any {
	result := make([]any, 0)
	if receivers != nil {
		for _, receiver := range *receivers {
			val := make(map[string]any)

			val["name"] = receiver.Name
			val["country_code"] = receiver.CountryCode
			val["phone_number"] = receiver.PhoneNumber

			result = append(result, val)
		}
	}
	return result
}
