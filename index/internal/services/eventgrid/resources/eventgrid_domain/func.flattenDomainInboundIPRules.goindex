package github.com/hashicorp/terraform-provider-azurerm/internal/services/eventgrid/resources/eventgrid_domain
import (
	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/go-azure-sdk/resource-manager/eventgrid/2025-02-15/domains"
)
func flattenDomainInboundIPRules(input *[]domains.InboundIPRule) []any {
	rules := make([]any, 0)
	if input == nil {
		return rules
	}

	for _, r := range *input {
		action := ""
		if r.Action != nil {
			action = string(*r.Action)
		}

		rules = append(rules, map[string]any{
			"action":  action,
			"ip_mask": pointer.From(r.IPMask),
		})
	}
	return rules
}
