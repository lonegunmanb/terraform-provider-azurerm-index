package github.com/hashicorp/terraform-provider-azurerm/internal/services/frontdoor
import (
	"github.com/hashicorp/terraform-plugin-framework/action"
	"github.com/hashicorp/terraform-plugin-framework/ephemeral"
	"github.com/hashicorp/terraform-provider-azurerm/internal/sdk"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/frontdoor/resources/frontdoor"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/frontdoor/resources/frontdoor_custom_https_configuration"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/frontdoor/resources/frontdoor_firewall_policy"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/frontdoor/resources/frontdoor_rules_engine"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func (r Registration) SupportedResources() map[string]*pluginsdk.Resource {
	return map[string]*pluginsdk.Resource{
		"azurerm_frontdoor":                            frontdoor.RegisterResource(),
		"azurerm_frontdoor_custom_https_configuration": frontdoor_custom_https_configuration.RegisterResource(),
		"azurerm_frontdoor_firewall_policy":            frontdoor_firewall_policy.RegisterResource(),
		"azurerm_frontdoor_rules_engine":               frontdoor_rules_engine.RegisterResource(),
	}
}
