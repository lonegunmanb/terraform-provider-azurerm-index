func flattenSystemAssigned(input *identity.SystemAndUserAssignedMap) []any {
	if input == nil {
		return []any{}
	}

	if input.Type == identity.TypeNone {
		return []any{}
	}

	return []any{
		map[string]any{
			"type":         input.Type,
			"principal_id": input.PrincipalId,
			"tenant_id":    input.TenantId,
		},
	}
}
