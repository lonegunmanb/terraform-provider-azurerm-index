package github.com/hashicorp/terraform-provider-azurerm/internal/services/portal
import (
	"github.com/hashicorp/terraform-plugin-framework/action"
	"github.com/hashicorp/terraform-plugin-framework/ephemeral"
	"github.com/hashicorp/terraform-provider-azurerm/internal/sdk"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/portal/resources/portal_dashboard"
	"github.com/hashicorp/terraform-provider-azurerm/internal/services/portal/resources/portal_tenant_configuration"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tf/pluginsdk"
)
func (r Registration) SupportedResources() map[string]*pluginsdk.Resource {
	return map[string]*pluginsdk.Resource{
		"azurerm_portal_dashboard":            portal_dashboard.RegisterResource(),
		"azurerm_portal_tenant_configuration": portal_tenant_configuration.RegisterResource(),
	}
}
