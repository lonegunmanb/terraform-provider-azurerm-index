func (id ResourceIdGenerator) lintIgnoreAT003() string {
	if !strings.HasPrefix(id.TypeName, "Acc") {
		return ""
	}
	return "// lintignore:AT003 // unit test for a generated Resource ID whose Type Name begins with `Acc`\n"
}
