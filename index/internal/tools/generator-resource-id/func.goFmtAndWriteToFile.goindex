package github.com/hashicorp/terraform-provider-azurerm/internal/tools/main
import (
	"context"
	"flag"
	"fmt"
	"os"
	"os/exec"
	"path"
	"path/filepath"
	"regexp"
	"sort"
	"strings"
	"unicode"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"golang.org/x/text/cases"
	"golang.org/x/text/language"
)
func goFmtAndWriteToFile(filePath, fileContents string) error {
	fmt, err := GolangCodeFormatter{}.Format(fileContents)
	if err != nil {
		return err
	}

	if err := os.WriteFile(filePath, []byte(*fmt), 0o644); err != nil {
		return err
	}

	return nil
}
