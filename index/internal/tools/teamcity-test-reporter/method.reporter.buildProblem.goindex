package github.com/hashicorp/terraform-provider-azurerm/internal/tools/main
import (
	"bufio"
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"sort"
	"strings"
)
func (r *reporter) buildProblem(description string) {
	r.failed = true
	fmt.Fprintf(r.out, "##teamcity[buildProblem description='%s']\n", escape(description))
}
