package github.com/hashicorp/terraform-provider-azurerm/internal/tools/templatehelpers
import (
	"context"
	"errors"
	"fmt"
	"os"
	"os/exec"
)
func GoImportsPath(path string) error {
	cmd := exec.CommandContext(context.Background(), "goimports", "-w", path)

	if _, err := cmd.CombinedOutput(); err != nil {
		return err
	}

	return nil
}
