package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/lint
import (
	"bufio"
	"bytes"
	"fmt"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
)
func (c *Changes) ChangedFiles() []string {
	out := make([]string, 0, len(c.files))
	for f := range c.files {
		out = append(out, f)
	}
	return out
}
