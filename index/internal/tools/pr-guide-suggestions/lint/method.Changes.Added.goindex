package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/lint
import (
	"bufio"
	"bytes"
	"fmt"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
)
func (c *Changes) Added(file string, line int) bool {
	if c == nil {
		return false
	}
	abs, err := filepath.Abs(file)
	if err != nil {
		abs = file
	}
	lines, ok := c.files[abs]
	return ok && lines[line]
}
