package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/lint
import (
	"fmt"
	"os"
	"regexp"
)
func Unfixed(findings []Finding) []Finding {
	out := make([]Finding, 0, len(findings))
	for _, f := range findings {
		if f.Rename == nil {
			out = append(out, f)
		}
	}
	return out
}
