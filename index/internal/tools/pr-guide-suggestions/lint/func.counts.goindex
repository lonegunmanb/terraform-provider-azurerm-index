package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/lint
import (
	"encoding/json"
	"fmt"
	"io"
	"path/filepath"
	"strings"
)
func counts(findings []Finding) (errors, warnings int) {
	for _, f := range findings {
		if f.Severity == "error" {
			errors++
		} else {
			warnings++
		}
	}
	return errors, warnings
}
