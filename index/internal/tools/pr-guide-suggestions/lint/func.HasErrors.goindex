package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/lint
import (
	"encoding/json"
	"fmt"
	"io"
	"path/filepath"
	"strings"
)
func HasErrors(findings []Finding) bool {
	for _, f := range findings {
		if f.Severity == "error" {
			return true
		}
	}
	return false
}
