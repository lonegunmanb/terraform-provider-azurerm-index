package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/astutil
import (
	"go/ast"
	"go/token"
	"strconv"
)
func ExprBoolValue(e ast.Expr) *bool {
	id, ok := e.(*ast.Ident)
	if !ok {
		return nil
	}
	switch id.Name {
	case "true":
		v := true
		return &v
	case "false":
		v := false
		return &v
	}
	return nil
}
