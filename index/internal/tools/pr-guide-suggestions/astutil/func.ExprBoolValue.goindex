package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/astutil
import (
	"go/ast"
	"go/token"
	"strconv"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
)
func ExprBoolValue(e ast.Expr) *bool {
	id, ok := e.(*ast.Ident)
	if !ok {
		return nil
	}
	switch id.Name {
	case "true":
		return pointer.To(true)
	case "false":
		return pointer.To(false)
	}
	return nil
}
