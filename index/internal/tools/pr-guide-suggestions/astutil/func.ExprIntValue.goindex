package github.com/hashicorp/terraform-provider-azurerm/internal/tools/pr-guide-suggestions/astutil
import (
	"go/ast"
	"go/token"
	"strconv"
)
func ExprIntValue(e ast.Expr) *int {
	switch v := e.(type) {
	case *ast.BasicLit:
		if v.Kind == token.INT {
			if n, err := strconv.Atoi(v.Value); err == nil {
				return &n
			}
		}
	case *ast.UnaryExpr:
		if v.Op == token.SUB {
			if inner := ExprIntValue(v.X); inner != nil {
				n := -*inner
				return &n
			}
		}
	}
	return nil
}
