package github.com/hashicorp/terraform-provider-azurerm/internal/tools/preview-api-version-linter/version
import (
	"fmt"
	"net/mail"
	"os"
	"regexp"
	"sort"
	"strings"
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/pointer"
	"github.com/hashicorp/terraform-provider-azurerm/internal/tools/preview-api-version-linter/sdk"
	"gopkg.in/yaml.v3"
)
func validResponsibleIndividual(s string) bool {
	for item := range strings.SplitSeq(s, ",") {
		item = strings.TrimSpace(item)
		if item == "" {
			return false
		}
		if _, err := mail.ParseAddress(item); err == nil {
			continue
		}
		if !githubHandleRegex.MatchString(item) {
			return false
		}
	}
	return true
}
