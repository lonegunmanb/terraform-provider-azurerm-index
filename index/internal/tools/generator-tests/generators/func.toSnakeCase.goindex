package github.com/hashicorp/terraform-provider-azurerm/internal/tools/generator-tests/generators
import (
	"fmt"
	"go/ast"
	"go/parser"
	"go/token"
	"os"
	"path/filepath"
	"strings"
	"unicode"
)
func toSnakeCase(s string) string {
	var res strings.Builder
	for i, r := range s {
		if unicode.IsUpper(r) {
			if i > 0 {
				res.WriteByte('_')
			}
			res.WriteRune(unicode.ToLower(r))
		} else {
			res.WriteRune(r)
		}
	}
	// Some structs might end up with `i_d`, fix to `id`
	return strings.ReplaceAll(res.String(), "_i_d", "_id")
}
